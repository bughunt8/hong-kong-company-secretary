# ============================================================
# Hong Kong Company Secretary LLM Bot – Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# -----------------------------------------------------------
# LLM / Ollama Settings
# -----------------------------------------------------------

# URL of the Ollama server (default: internal Docker network)
OLLAMA_URL=http://ollama:11434

# Model to use – any model available in Ollama.
# Examples:
#   llama3           – Meta LLaMA 3 (recommended default)
#   mistral          – Mistral 7B
#   gemma:7b         – Google Gemma 7B
#   nemoclaw         – Custom Nemoclaw model (load via Modelfile, see README)
#   openclaw         – Custom Openclaw model (load via Modelfile, see README)
LLM_MODEL=llama3

# -----------------------------------------------------------
# WhatsApp Cloud API (Meta for Developers)
# Obtain from: https://developers.facebook.com/
# -----------------------------------------------------------

# Your WhatsApp Business App bearer token
WHATSAPP_TOKEN=

# WhatsApp Phone Number ID (from Meta developer console)
WHATSAPP_PHONE_NUMBER_ID=

# Webhook verify token – choose any secret string.
# Must match the value entered in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=hkcs_verify

# -----------------------------------------------------------
# Application Settings
# -----------------------------------------------------------

# Directory containing wiki markdown files
WIKI_DIR=/app/wiki

# Number of top articles to retrieve per query (RAG top-k)
RETRIEVAL_TOP_K=3
